name: Decompile

on:
  workflow_dispatch:
    inputs:
      keywords:
        description: 'খোঁজার regex (যেমন UploadStatus|ForegroundService)'
        required: true

jobs:
  decompile:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5

      - uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: 17

      - name: Decompile and search
        run: |
          wget -q https://github.com/iBotPeaches/Apktool/releases/download/v2.9.3/apktool_2.9.3.jar -O apktool.jar
          wget -q https://github.com/skylot/jadx/releases/download/v1.5.0/jadx-1.5.0.zip
          unzip -q jadx-1.5.0.zip -d jadx

          java -jar apktool.jar d -f input/app.apk -o smali_out
          jadx/bin/jadx -d java_out --no-res input/app.apk || true

          mkdir found
          grep -rlE "${{ github.event.inputs.keywords }}" smali_out --include=*.smali | head -150 | while read f; do
            mkdir -p "found/$(dirname "$f")"; cp "$f" "found/$f"
          done
          grep -rlE "${{ github.event.inputs.keywords }}" java_out --include=*.java | head -150 | while read f; do
            mkdir -p "found/$(dirname "$f")"; cp "$f" "found/$f"
          done
          cp smali_out/AndroidManifest.xml found/
          find found -type f | wc -l

      - uses: actions/upload-artifact@v4
        with:
          name: found
          path: found
